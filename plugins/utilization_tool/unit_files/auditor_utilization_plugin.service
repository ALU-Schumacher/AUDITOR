[Unit]
Description=Utilization report for AUDITOR
Documentation=https://alu-schumacher.github.io/AUDITOR/

[Service]
Type=oneshot
User=auditor-utilization-plugin
Group=auditor
StateDirectory=auditor_utilization_plugin
StateDirectoryMode=0750
WorkingDirectory=/var/lib/auditor_utilization_plugin
ExecStart=/opt/auditor_utilization_plugin/venv/bin/auditor-utilization-plugin --config /etc/auditor/auditor_utilization_plugin.yml --oneshot

